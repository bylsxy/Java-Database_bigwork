<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.imagemanager.controller.ImageViewerController"
           fx:id="viewerRoot"
           prefWidth="960" prefHeight="680"
           styleClass="viewer-root">
    <ImageView fx:id="themeBackgroundImageView" preserveRatio="false" smooth="true"
               mouseTransparent="true"/>
    <BorderPane fx:id="viewerContentPane" styleClass="viewer-content-pane">
        <center>
            <StackPane fx:id="imageContainer" styleClass="viewer-image-container">
                <ImageView fx:id="mainImageView" preserveRatio="true" smooth="true"/>
            </StackPane>
        </center>

        <bottom>
            <VBox styleClass="viewer-controls" spacing="0">
                <HBox styleClass="viewer-info-bar" alignment="CENTER" spacing="5">
                    <padding><Insets top="4" right="10" bottom="4" left="10"/></padding>
                    <Label fx:id="infoLabel" text="就绪" styleClass="viewer-info-text"/>
                </HBox>

                <HBox styleClass="viewer-control-bar" alignment="CENTER" spacing="10">
                    <padding><Insets top="8" right="15" bottom="8" left="15"/></padding>
                    <Button text="放大" onAction="#onZoomIn" styleClass="viewer-button" prefWidth="58"/>
                    <Button text="缩小" onAction="#onZoomOut" styleClass="viewer-button" prefWidth="58"/>
                    <Button text="适应" onAction="#onFitToWindow" styleClass="viewer-button" prefWidth="58"/>
                    <Button text="1:1" onAction="#onActualSize" styleClass="viewer-button" prefWidth="58"/>

                    <Separator orientation="VERTICAL" prefHeight="25"/>

                    <Button fx:id="prevButton" text="上一张" onAction="#onPrevious"
                            styleClass="viewer-button" prefWidth="70"/>
                    <Button fx:id="nextButton" text="下一张" onAction="#onNext"
                            styleClass="viewer-button" prefWidth="70"/>

                    <Separator orientation="VERTICAL" prefHeight="25"/>

                    <Button text="编辑" onAction="#onEdit" styleClass="viewer-button" prefWidth="70"/>
                    <Button text="幻灯片播放" onAction="#onPlay"
                            styleClass="viewer-button viewer-play-button" prefWidth="100"/>
                    <Button text="关闭" onAction="#onClose"
                            styleClass="viewer-button viewer-close-button" prefWidth="70"/>
                </HBox>
            </VBox>
        </bottom>
    </BorderPane>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<!--
    首次启动向导 — 询问用户扫描目录，警告 tokens 消费。
    调试阶段每次都打开，勾选"下次不展示"后关闭。
    在设置页面中可重新调出。
-->
<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.imagemanager.controller.WelcomeDialogController"
            prefWidth="640" prefHeight="620" minWidth="560" minHeight="360"
            styleClass="welcome-dialog">

    <header>
        <VBox spacing="8" alignment="CENTER">
            <padding><Insets top="10" bottom="5"/></padding>
            <Label text="欢迎使用 数字图像集成管理系统"
                   styleClass="welcome-title"/>
            <Label text="首次使用，请选择您的图片目录" styleClass="welcome-subtitle"/>
        </VBox>
    </header>

    <content>
        <ScrollPane fx:id="contentScrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="true"
                    prefViewportWidth="590"
                    prefViewportHeight="430"
                    styleClass="settings-scroll">
            <VBox spacing="16" alignment="TOP_LEFT" styleClass="welcome-content">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>

                <!-- 目录选择区域 -->
                <VBox spacing="8">
                    <Label text="图片扫描目录"
                           styleClass="section-label"/>
                    <Label text="系统将深度遍历此目录下的所有图片，并通过AI进行智能分类标注。"
                           wrapText="true" styleClass="helper-text"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="directoryField" prefWidth="420" maxWidth="Infinity"
                                   promptText="请选择或输入图片目录路径..." editable="true"
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="browseButton" text="浏览..." onAction="#onBrowseDirectory"/>
                    </HBox>
                </VBox>

                <Separator/>

                <!-- 目录预估信息 -->
                <VBox fx:id="estimateBox" spacing="6" visible="false" managed="false">
                    <Label fx:id="estimateLabel" wrapText="true"
                           styleClass="helper-text"/>
                    <Label fx:id="warningLabel" wrapText="true"
                           styleClass="danger-text"
                           visible="false" managed="false"/>
                </VBox>

                <!-- API 配置提示 -->
                <VBox spacing="6" styleClass="info-callout">
                    <Label text="AI 图像识别配置"
                           styleClass="section-label"/>
                    <Label text="AI 图像识别使用本机私有配置文件中的端点列表。您可以在「设置」中维护 fallback 顺序、密钥和模型，也可稍后配置。"
                           wrapText="true" styleClass="helper-text"/>
                    <Hyperlink fx:id="settingsLink" text="打开设置页面配置 AI API" onAction="#onOpenSettings"
                               />
                </VBox>

                <Separator/>

                <!-- 注意事项 -->
                <VBox spacing="4" styleClass="warning-callout">
                    <Label text="注意事项" styleClass="warning-title"/>
                    <Label text="• 打开过大的目录可能导致不必要的 AI tokens 消费" wrapText="true"
                           styleClass="warning-text"/>
                    <Label text="• 建议先选择一个较小的目录（如 Pictures 文件夹）进行测试" wrapText="true"
                           styleClass="warning-text"/>
                    <Label text="• 扫描过程在后台运行，不影响正常使用" wrapText="true"
                           styleClass="warning-text"/>
                </VBox>

                <!-- 下次不展示 -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <CheckBox fx:id="dontShowAgainCheckBox" text="下次不展示本页面"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </content>

    <ButtonType fx:constant="OK"/>
    <ButtonType fx:constant="CANCEL"/>
</DialogPane>

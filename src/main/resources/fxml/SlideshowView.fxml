<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
    幻灯片播放界面布局 (v2.0 改进版)
    
    ┌────────────────────────────────────────────────────┐
    │           [大图展示区 - 深色背景]                     │
    │                                                    │
    │              ImageView                             │
    │              (居中, 保持比例)                         │
    │                                                    │
    ├────────────────────────────────────────────────────┤
    │  [图片信息条]                                        │
    ├────────────────────────────────────────────────────┤
    │  [🔍+🔍-] [⬅ ➡] [▶播放] [🎵音乐▼] [🔊音量] [✕退出] │
    ├────────────────────────────────────────────────────┤
    │  [缩略图条: 水平排列的小缩略图]                       │
    └────────────────────────────────────────────────────┘
-->

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.imagemanager.controller.SlideshowController"
           fx:id="slideshowRoot"
           prefWidth="1000" prefHeight="700"
           styleClass="slideshow-root">
    <ImageView fx:id="themeBackgroundImageView" preserveRatio="false" smooth="true"
               mouseTransparent="true"/>
    <BorderPane fx:id="slideshowContentPane" styleClass="slideshow-content-pane">

    <!-- ==================== 中央：大图展示区 ==================== -->
    <center>
        <StackPane fx:id="imageContainer" styleClass="image-container">
            <ImageView fx:id="mainImageView" preserveRatio="true" smooth="true"/>
        </StackPane>
    </center>

    <!-- ==================== 底部：控制区域 ==================== -->
    <bottom>
        <VBox styleClass="slideshow-controls" spacing="0">

            <!-- 图片信息条 -->
            <HBox styleClass="info-bar" alignment="CENTER" spacing="5">
                <padding><Insets top="4" right="10" bottom="4" left="10"/></padding>
                <Label fx:id="infoLabel" text="就绪" styleClass="info-text"/>
            </HBox>

            <!-- 控制按钮栏 -->
            <FlowPane styleClass="control-bar" alignment="CENTER" hgap="8" vgap="6" prefWrapLength="1000">
                <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>

                <!-- 缩放控制 -->
                <Button fx:id="zoomInButton" text="放大" onAction="#onZoomIn"
                        styleClass="control-button" prefWidth="58" minWidth="58"/>
                <Button fx:id="zoomOutButton" text="缩小" onAction="#onZoomOut"
                        styleClass="control-button" prefWidth="58" minWidth="58"/>

                <Button fx:id="fitButton" text="适应" onAction="#onFitToWindow"
                        styleClass="control-button" prefWidth="58" minWidth="58"/>
                <Button fx:id="actualSizeButton" text="1:1" onAction="#onActualSize"
                        styleClass="control-button" prefWidth="54" minWidth="54"/>

                <Separator orientation="VERTICAL" prefHeight="25"/>

                <!-- 导航控制 -->
                <Button fx:id="prevButton" text="上一张" onAction="#onPrevious"
                        styleClass="control-button" prefWidth="70" minWidth="70"/>
                <Button fx:id="nextButton" text="下一张" onAction="#onNext"
                        styleClass="control-button" prefWidth="70" minWidth="70"/>

                <CheckBox fx:id="loopCheckBox" text="循环" selected="true"
                          styleClass="slideshow-check" prefWidth="64" minWidth="64"/>
                <Button fx:id="fullScreenButton" text="全屏" onAction="#onToggleFullScreen"
                        styleClass="control-button" prefWidth="60" minWidth="60"/>

                <Separator orientation="VERTICAL" prefHeight="25"/>

                <!-- 播放控制 -->
                <Button fx:id="playButton" text="播放" onAction="#onPlayToggle"
                        styleClass="control-button play-button" prefWidth="64" minWidth="64"/>

                <Separator orientation="VERTICAL" prefHeight="25"/>

                <!-- v2.0新增：背景音乐控制 -->
                <ComboBox fx:id="musicCombo" prefWidth="132" minWidth="132" promptText="背景音乐"
                          styleClass="music-combo"/>
                <Button fx:id="musicToggleButton" text="播放音乐" onAction="#onMusicToggle"
                        styleClass="control-button" prefWidth="88" minWidth="88"/>
                <Slider fx:id="volumeSlider" min="0" max="1" value="0.5"
                        prefWidth="78" minWidth="78" styleClass="volume-slider"/>

                <Separator orientation="VERTICAL" prefHeight="25"/>

                <!-- 退出 -->
                <Button fx:id="exitButton" text="退出" onAction="#onExit"
                        styleClass="control-button exit-button" prefWidth="60" minWidth="60"/>
            </FlowPane>

            <!-- 底部缩略图条 -->
            <ScrollPane fx:id="thumbnailStripScroll" styleClass="thumbnail-strip-scroll"
                        fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED"
                        prefHeight="80">
                <HBox fx:id="thumbnailStrip" styleClass="thumbnail-strip"
                      spacing="5" alignment="CENTER_LEFT">
                    <padding><Insets topRightBottomLeft="5"/></padding>
                </HBox>
            </ScrollPane>
        </VBox>
    </bottom>
    </BorderPane>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- 设置页面 — 本机 AI fallback、扫描目录管理、显示偏好。 -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.imagemanager.controller.SettingsController"
           fx:id="settingsRoot"
           prefWidth="850" prefHeight="900" styleClass="settings-root">
    <ImageView fx:id="themeBackgroundImageView" preserveRatio="true" smooth="true"
               managed="false" mouseTransparent="true"/>
    <VBox fx:id="settingsContentPane" spacing="16"
          maxWidth="Infinity" maxHeight="Infinity"
          styleClass="settings-content-pane">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

        <Label text="系统设置" styleClass="settings-title"/>
        <Separator/>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="settings-scroll">
            <VBox spacing="20">
                <padding><Insets top="4" right="8" bottom="4" left="4"/></padding>

                <TitledPane text="AI 图像识别 API 配置" expanded="true" collapsible="true"
                            styleClass="settings-section">
                    <VBox spacing="12">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                        <Label text="AI 配置只保存在本机私有配置文件中。运行时按列表顺序尝试端点，失败后临时降级，连续失败达到阈值后在本次会话中熔断。"
                               wrapText="true" styleClass="helper-text"/>
                        <Label fx:id="configPathLabel" wrapText="true" styleClass="small-helper-text"/>

                        <HBox spacing="14" VBox.vgrow="ALWAYS">
                            <VBox spacing="8" prefWidth="250" HBox.hgrow="NEVER">
                                <Label text="Fallback 顺序" styleClass="section-label"/>
                                <ListView fx:id="endpointListView" prefHeight="260" VBox.vgrow="ALWAYS"/>
                                <HBox spacing="6">
                                    <Button text="+" onAction="#onAddEndpoint" styleClass="secondary-button"/>
                                    <Button text="-" onAction="#onRemoveEndpoint" styleClass="secondary-button"/>
                                    <Button text="上移" onAction="#onMoveEndpointUp" styleClass="secondary-button"/>
                                    <Button text="下移" onAction="#onMoveEndpointDown" styleClass="secondary-button"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <GridPane hgap="12" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="92" prefWidth="92" halignment="RIGHT"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="名称:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                           styleClass="field-label"/>
                                    <TextField fx:id="endpointNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                               promptText="主端点 / 备用1"/>

                                    <Label text="Base URL:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                           styleClass="field-label"/>
                                    <TextField fx:id="endpointBaseUrlField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                               promptText="OpenAI-compatible /v1 地址"/>

                                    <Label text="API Key:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                           styleClass="field-label"/>
                                    <PasswordField fx:id="endpointApiKeyField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                                   promptText="仅保存到本机私有配置文件"/>

                                    <Label text="模型:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                           styleClass="field-label"/>
                                    <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <ComboBox fx:id="modelComboBox" HBox.hgrow="ALWAYS"
                                                      prefWidth="380" promptText="刷新后选择，或手动输入"/>
                                            <Button fx:id="refreshModelsButton" text="刷新模型" onAction="#onRefreshModels"
                                                    styleClass="secondary-button"/>
                                        </HBox>
                                        <Label fx:id="modelStatusLabel" text="模型列表从当前端点的 /models 获取"
                                               wrapText="true" styleClass="small-helper-text"/>
                                    </VBox>

                                    <Label text="启用:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                                           styleClass="field-label"/>
                                    <CheckBox fx:id="endpointEnabledCheckBox" text="参与 fallback"
                                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                </GridPane>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Button text="验证全部 /models" onAction="#onValidateAllEndpoints"
                                            styleClass="primary-button"/>
                                    <Button text="重置熔断" onAction="#onResetCircuitBreakers"
                                            styleClass="secondary-button"/>
                                    <Button text="恢复默认 fallback" onAction="#onRestoreDefaultFallback"
                                            styleClass="warning-button"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <Separator/>

                        <GridPane hgap="12" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="120" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="请求间隔:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                   styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <TextField fx:id="delayField" prefWidth="90" promptText="1500"/>
                                <Label text="毫秒" styleClass="helper-text"/>
                            </HBox>

                            <Label text="熔断阈值:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                   styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <TextField fx:id="circuitBreakerField" prefWidth="90" promptText="5"/>
                                <Label text="次连续失败后跳过该端点" styleClass="helper-text"/>
                            </HBox>

                            <Label text="单批上限(max):" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                   styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <Spinner fx:id="batchLimitSpinner" prefWidth="110"/>
                                <Label text="张" styleClass="helper-text"/>
                            </HBox>
                        </GridPane>

                        <VBox spacing="6">
                            <Label text="实时连接测试" styleClass="section-label"/>
                            <Label text="上传一张示例图片，验证 API 是否正确返回标签（会消耗一次图像识别请求）。"
                                   wrapText="true" styleClass="helper-text"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button text="选择图片并测试" onAction="#onTestWithImage"
                                        styleClass="primary-button"/>
                                <Label text="建议平时先用 /models 验证，答辩前再做图片测试。"
                                       styleClass="helper-text"/>
                            </HBox>
                        </VBox>

                        <TextArea fx:id="testResultArea" prefRowCount="7" editable="false" wrapText="true"
                                  promptText="验证结果将显示在此处..."
                                  styleClass="test-result-area"/>
                    </VBox>
                </TitledPane>

                <TitledPane text="扫描目录设置" expanded="true" collapsible="true"
                            styleClass="settings-section">
                    <VBox spacing="10">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                        <Label text="当前扫描目录:" styleClass="field-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="scanDirField" HBox.hgrow="ALWAYS"
                                       promptText="选择图片扫描目录..." editable="true"/>
                            <Button text="浏览..." onAction="#onBrowseScanDir" styleClass="secondary-button"/>
                        </HBox>

                        <HBox spacing="10">
                            <Button text="扫描当前目录" onAction="#onScanCurrentDirectory"
                                    styleClass="primary-button"/>
                            <Button text="下次启动显示向导" onAction="#onReopenWelcome"
                                    styleClass="warning-button"/>
                            <Label text="AI识别单批上限按 N(max) 显示，可在上方调整"
                                   styleClass="helper-text"
                                   alignment="CENTER_LEFT"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <TitledPane text="界面主题设置" expanded="true" collapsible="true"
                            styleClass="settings-section">
                    <VBox spacing="14">
                        <padding><Insets top="12" right="12" bottom="18" left="12"/></padding>

                        <Label text="主题背景会应用到主窗口、设置窗口、图片查看器、幻灯片窗口和图片编辑器。背景按比例裁切填满窗口。"
                               wrapText="true" styleClass="helper-text"/>

                        <GridPane hgap="12" vgap="14">
                            <columnConstraints>
                                <ColumnConstraints minWidth="92" prefWidth="92" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="背景图片:" styleClass="field-label"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <HBox spacing="10" alignment="CENTER_LEFT"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <TextField fx:id="themeBackgroundField" HBox.hgrow="ALWAYS"
                                           promptText="未设置主题背景" editable="false"/>
                                <Button text="选择..." onAction="#onBrowseThemeBackground" styleClass="secondary-button"/>
                                <Button text="清除" onAction="#onClearThemeBackground" styleClass="secondary-button"/>
                            </HBox>
                        </GridPane>
                    </VBox>
                </TitledPane>

                <TitledPane text="幻灯片设置" expanded="false" collapsible="true"
                            styleClass="settings-section">
                    <VBox spacing="10">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="播放间隔:" styleClass="field-label"/>
                            <Spinner fx:id="intervalSpinner" prefWidth="80"/>
                            <Label text="秒" styleClass="helper-text"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="播放顺序:" styleClass="field-label"/>
                            <ComboBox fx:id="orderComboBox" prefWidth="160"/>
                        </HBox>
                    </VBox>
                </TitledPane>
            </VBox>
        </ScrollPane>

        <Separator/>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="saveButton" text="保存设置" onAction="#onSave"
                    styleClass="success-button"/>
            <Button fx:id="cancelButton" text="取消" onAction="#onCancel"
                    styleClass="secondary-button"/>
        </HBox>
    </VBox>
</StackPane>

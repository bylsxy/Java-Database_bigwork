<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.imagemanager.controller.MainController"
           fx:id="appRoot"
           prefWidth="1200" prefHeight="800"
           styleClass="root-pane">
    <ImageView fx:id="themeBackgroundImageView" preserveRatio="false" smooth="true"
               mouseTransparent="true"/>
    <BorderPane fx:id="mainContentPane" styleClass="theme-content-pane">

    <top>
        <VBox>
            <ToolBar styleClass="top-toolbar">
                <Label text="图片库" styleClass="toolbar-icon"/>
                <Label fx:id="pathLabel" text="我的图片" styleClass="path-label"/>
                <Pane HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="searchModeCombo" prefWidth="110"
                          promptText="搜索模式" styleClass="search-mode-combo"/>
                <TextField fx:id="searchField" prefWidth="260"
                           promptText="搜索图片、标签或 AI 描述..."
                           styleClass="search-field"/>
                <Button fx:id="searchButton" text="搜索" onAction="#onSearch"
                        styleClass="search-button"/>

                <Separator orientation="VERTICAL" prefHeight="24"/>

                <Button fx:id="settingsButton" text="设置" onAction="#onOpenSettings"
                        styleClass="settings-button"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <SplitPane fx:id="mainSplitPane" dividerPositions="0.25" styleClass="main-split">
            <VBox styleClass="tree-container">
                <Label text="我的图片" styleClass="tree-header"/>
                <TreeView fx:id="directoryTree" VBox.vgrow="ALWAYS" styleClass="directory-tree"/>
            </VBox>

            <VBox styleClass="preview-container">
                <HBox styleClass="directory-info-bar" alignment="CENTER_LEFT" spacing="10">
                    <padding><Insets top="5" right="10" bottom="5" left="10"/></padding>
                    <Label fx:id="directoryNameLabel" text="" styleClass="directory-name"/>
                    <Label fx:id="imageCountLabel" text="" styleClass="image-count"/>
                </HBox>

                <ScrollPane fx:id="thumbnailScroll" fitToWidth="true" VBox.vgrow="ALWAYS"
                            styleClass="thumbnail-scroll" pannable="true">
                    <FlowPane fx:id="thumbnailPane" hgap="15" vgap="15"
                              styleClass="thumbnail-pane" alignment="TOP_LEFT">
                        <padding><Insets topRightBottomLeft="15"/></padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="6" right="15" bottom="6" left="15"/></padding>
            <Label fx:id="statusLabel" text="就绪" styleClass="status-text"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="scanProgressLabel" text="" styleClass="scan-progress-label"
                   visible="false" managed="false"/>
            <ProgressBar fx:id="scanProgressBar" prefWidth="180" prefHeight="14"
                         styleClass="scan-progress-bar" visible="false" managed="false"/>

            <Separator orientation="VERTICAL" prefHeight="20"/>
            <Label fx:id="selectionLabel" text="" styleClass="selection-text"/>
            <Separator orientation="VERTICAL" prefHeight="20"/>
            <Button fx:id="slideshowButton" text="播放" onAction="#onSlideshow"
                    styleClass="slideshow-button" disable="true"/>
        </HBox>
    </bottom>
    </BorderPane>
</StackPane>

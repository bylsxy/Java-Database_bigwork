<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    设置页面 — AI API配置、扫描目录管理、显示偏好。
    包含实时测试功能：上传示例图片验证API连接和返回效果。
-->
<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.imagemanager.controller.SettingsController"
      spacing="16" prefWidth="620" prefHeight="680">

    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label text="系统设置" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Separator/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="20">
            <padding><Insets top="4" right="8" bottom="4" left="4"/></padding>

            <!-- ==================== AI API 配置 ==================== -->
            <TitledPane text="AI 图像识别 API 配置" expanded="true" collapsible="true">
                <VBox spacing="12">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <Label text="填写 OpenAI 兼容格式的 API 信息（支持通义千问、百度文心、GPT-4o 等）"
                           wrapText="true" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>

                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100" prefWidth="100" halignment="RIGHT"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Base URL:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold;"/>
                        <TextField fx:id="baseUrlField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   promptText="https://dashscope.aliyuncs.com/compatible-mode/v1"/>

                        <Label text="API Key:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold;"/>
                        <PasswordField fx:id="apiKeyField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                       promptText="请输入您的 API Key"/>

                        <Label text="模型名称:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold;"/>
                        <TextField fx:id="modelField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                   promptText="qwen-vl-plus"/>

                        <Label text="请求间隔:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT"
                              GridPane.rowIndex="3" GridPane.columnIndex="1">
                            <TextField fx:id="delayField" prefWidth="80" promptText="1500"/>
                            <Label text="毫秒（防止API限流）" style="-fx-text-fill: #666;"/>
                        </HBox>
                    </GridPane>

                    <Separator/>

                    <!-- 实时测试区域 -->
                    <Label text="实时连接测试" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="上传一张示例图片，验证API是否正确返回标签（测试标签数量、格式是否合法）"
                           wrapText="true" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="testButton" text="选择图片并测试" onAction="#onTestAPI"
                                style="-fx-background-color: #1976d2; -fx-text-fill: white;"/>
                        <ProgressIndicator fx:id="testProgress" prefWidth="24" prefHeight="24"
                                           visible="false"/>
                        <Label fx:id="testStatusLabel" text="" style="-fx-text-fill: #666;"/>
                    </HBox>

                    <TextArea fx:id="testResultArea" prefRowCount="8" editable="false" wrapText="true"
                              promptText="测试结果将显示在此处..."
                              style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px;"/>
                </VBox>
            </TitledPane>

            <!-- ==================== 扫描目录设置 ==================== -->
            <TitledPane text="扫描目录设置" expanded="true" collapsible="true">
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <Label text="当前扫描目录:" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="scanDirField" HBox.hgrow="ALWAYS"
                                   promptText="选择图片扫描目录..." editable="true"/>
                        <Button text="浏览..." onAction="#onBrowseScanDir"/>
                    </HBox>

                    <HBox spacing="10">
                        <Button text="重新打开首次向导" onAction="#onReopenWelcome"
                                style="-fx-background-color: #ff9800; -fx-text-fill: white;"/>
                        <Label text="可重新选择目录并触发扫描"
                               style="-fx-text-fill: #666; -fx-font-size: 12px;"
                               alignment="CENTER_LEFT"/>
                    </HBox>
                </VBox>
            </TitledPane>

            <!-- ==================== 幻灯片设置 ==================== -->
            <TitledPane text="幻灯片设置" expanded="false" collapsible="true">
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="播放间隔:" style="-fx-font-weight: bold;"/>
                        <Spinner fx:id="intervalSpinner" prefWidth="80"/>
                        <Label text="秒" style="-fx-text-fill: #666;"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="播放顺序:" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="orderComboBox" prefWidth="160"/>
                    </HBox>
                </VBox>
            </TitledPane>
        </VBox>
    </ScrollPane>

    <Separator/>

    <!-- 底部按钮栏 -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" text="保存设置" onAction="#onSave"
                style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 24;"/>
        <Button fx:id="cancelButton" text="取消" onAction="#onCancel"
                style="-fx-padding: 8 24;"/>
    </HBox>
</VBox>

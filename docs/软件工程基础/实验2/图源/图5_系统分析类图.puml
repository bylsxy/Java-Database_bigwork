@startuml
title DIMS 分析类图
skinparam packageStyle rectangle

package "Boundary Classes" {
  class MainView {
    +showDirectoryTree()
    +renderThumbnails()
    +updateStatusBar()
  }
  class RenameDialogView {
    +showDialog()
    +getRenameRules()
  }
  class SettingsView {
    +editDatabaseConfig()
    +editAIConfig()
  }
  class ImageViewerView {
    +showImage()
    +openSlideshow()
  }
}

package "Control Classes" {
  class DirectoryScannerControl {
    +scanDirectory(path)
    +loadThumbnails(path)
  }
  class RenameServiceControl {
    +batchRename(images, rules)
    +rollbackLocalFiles()
  }
  class AIServiceControl {
    +analyzeImage(image)
    +searchByNaturalLanguage(query)
  }
  class DatabaseManagerControl {
    +beginTransaction()
    +commit()
    +rollback()
    +executeQuery(sql)
  }
  class SettingsControl {
    +savePreference(item, value)
  }
}

package "Entity Classes" {
  class DirectoryNode {
    -dirName
    -path
  }
  class ImageFile {
    -filePath
    -fileName
    -fileSize
    -isDeleted
  }
  class ImageTag {
    -tagName
    -category
    -confidence
    -source
  }
  class OperationLog {
    -opType
    -timestamp
    -description
  }
  class AppSetting {
    -settingKey
    -settingValue
  }
}

MainView --> DirectoryScannerControl
MainView --> RenameDialogView
MainView --> ImageViewerView
RenameDialogView --> RenameServiceControl
SettingsView --> SettingsControl
DirectoryScannerControl --> DirectoryNode
DirectoryScannerControl --> ImageFile
DirectoryScannerControl --> DatabaseManagerControl
RenameServiceControl --> ImageFile
RenameServiceControl --> DatabaseManagerControl
AIServiceControl --> ImageFile
AIServiceControl --> ImageTag
AIServiceControl --> DatabaseManagerControl
SettingsControl --> AppSetting
DatabaseManagerControl --> OperationLog
@enduml

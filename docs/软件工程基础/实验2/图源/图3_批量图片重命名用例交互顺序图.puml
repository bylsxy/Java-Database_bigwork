@startuml
title "批量图片重命名"用例交互顺序图
actor "机主" as User
boundary "主界面\nMainView" as MainView
boundary "重命名对话框\nRenameDialogView" as RenameView
control "重命名控制器\nRenameServiceControl" as RenameCtrl
control "数据库控制器\nDatabaseManagerControl" as DBCtrl
entity "图片实体\nImageFile" as ImageFile

User -> MainView : 1. 选中多张图片并选择"重命名"
MainView -> RenameView : 2. showDialog(selectedImages)
User -> RenameView : 3. 输入前缀、起始编号和位数
RenameView -> RenameCtrl : 4. batchRename(images, rules)
RenameCtrl -> DBCtrl : 5. beginTransaction()
DBCtrl --> RenameCtrl : 6. 事务开启
loop 每一张目标图片
    RenameCtrl -> ImageFile : 7. renameLocalFile(newName)
    ImageFile --> RenameCtrl : 8. 返回本地重命名结果
    RenameCtrl -> DBCtrl : 9. updateRecord(oldName, newName)
    DBCtrl --> RenameCtrl : 10. 返回更新结果
end
alt 全部成功
    RenameCtrl -> DBCtrl : 11. commit()
    DBCtrl --> RenameCtrl : 12. 提交成功
else 任一文件或数据库更新失败
    RenameCtrl -> DBCtrl : 13. rollback()
    RenameCtrl -> ImageFile : 14. rollbackLocalFiles()
end
RenameCtrl --> RenameView : 15. 返回执行结果
RenameView --> MainView : 16. closeAndRefresh()
MainView --> User : 17. 状态栏显示结果并刷新文件名
@enduml
